{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(wait)",
      "Bash(touch *)",
      "Bash(mkdir *)",

      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git commit *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-tree *)",
      "Bash(git --no-pager log *)",
      "Bash(git --no-pager show *)",
      "Bash(git --no-pager diff *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",

      "Bash(npm ls *)",
      "Bash(npm list *)",
      "Bash(npm view *)",
      "Bash(npm test *)",
      "Bash(npm run format *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",

      "Bash(xcode-select -p)",
      "Bash(xcrun simctl list *)",
      "Bash(xcodebuild *)",
      "Bash(swift build *)",
      "Bash(code --list-extensions)",

      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:apps.apple.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:support.apple.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:*.npmjs.com)",
      "WebFetch(domain:*.npmjs.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:www.jetbrains.com)",
      "WebFetch(domain:www.chezmoi.io)",

      "mcp__plugin_context7_context7__*",
      "mcp__plugin_playwright_playwright__*"
    ],
    "deny": [
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fls*)",
      "Bash(find * -fprint*)",
      "Bash(rg --pre*)",
      "Bash(rg * --pre*)",
      "Bash(rg --hostname-bin*)",
      "Bash(rg * --hostname-bin*)",

      "Bash(git credential*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(gh auth token *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",

      "Bash(npm publish *)",

      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.envrc)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.zsh_history)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.jks)",
      "Read(//**/*.key)",
      "Read(//**/*.keystore)",
      "Read(//**/*.pem)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p8)",
      "Read(//**/*.p12)",

      "mcp__plugin_playwright_playwright__browser_run_code_unsafe"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(wget *)",

      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(gh api *)",
      "Bash(gh gist *)",
      "Bash(gh secret *)",
      "Bash(gh repo list *)",
      "Bash(gh repo create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",

      "Edit(.github/workflows/**)",

      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_file_upload",
      "mcp__plugin_playwright_playwright__browser_drop",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_tabs"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/validate.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq '. + {\"notification_type\": \"stop\"}' | ~/.claude/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@anthropic-plugin-directory": true
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "api.appstoreconnect.apple.com",
        "cdn.cocoapods.org"
      ],
      "deniedDomains": ["uploads.github.com", "*.pkg.github.com"],
      "allowLocalBinding": true
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": ["git push -u *", "git push --set-upstream *"]
  },
  "spinnerTipsEnabled": false,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 100000
    }
  },
  "awaySummaryEnabled": false,
  "companyAnnouncements": ["📚️ https://code.claude.com/docs/ja/settings"],
  "tui": "fullscreen",
  "verbose": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": true,
  "showTurnDuration": true,
  "remoteControlAtStartup": true
}
