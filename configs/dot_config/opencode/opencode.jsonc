{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "agent": {
    "build": {
      "model": "opencode-go/kimi-k2.7-code",
    },
    "plan": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "xhigh",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
  "permission": {
    "read": {
      "*": "allow",

      ".ssh/*": "deny",
      ".gnupg/*": "deny",
      ".aws/*": "deny",
      ".azure/*": "deny",
      ".config/gcloud/*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      "*.pem": "deny",
      "*.pfx": "deny",
      "*.p8": "deny",
      "*.p12": "deny",
      "*.key": "deny",
      "*.keystore": "deny",
    },

    "bash": {
      "*": "ask",

      "sudo *": "deny",
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "gh repo delete *": "deny",
      "gh auth token *": "deny",

      "rm *": "ask",
      "chmod *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "find *": "ask",

      "* --version": "allow",
      "* --help": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "touch *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "command cp *": "allow",
      "wait": "allow",
      "git fetch *": "allow",
      "git pull *": "allow",
      "git mv *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git ls-tree *": "allow",
      "git ls-remote *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git --no-pager log *": "allow",
      "git diff *": "allow",
      "git --no-pager diff *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git describe *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git check-ignore *": "allow",
      "gh repo view *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "npm ls *": "allow",
      "npm list *": "allow",
      "npm view *": "allow",
      "npm test *": "allow",
      "npm run format *": "allow",
      "npm run lint *": "allow",
      "npm run typecheck *": "allow",
      "npm run test *": "allow",
      "npm run build *": "allow",
      "npx prettier *": "allow",
      "npx eslint *": "allow",
      "npx tsc *": "allow",
      "npx jest *": "allow",
      "npx vitest *": "allow",
      "swift build *": "allow",
      "xcodebuild *": "allow",
      "xcode-select -p": "allow",
      "xcrun simctl list *": "allow",
      "code --list-extensions": "allow",
    },
  },
}
